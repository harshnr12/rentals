### ==========================================
###     AUTHENTICATION
### ==========================================

### Signup
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
    "name": "Harsh Test",
    "email": "harsh@example.com",
    "password": "password123",
    "phone": "9876543210"
}


### Login
# Copy the returned token into @token above
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "harsh@example.com",
    "password": "password123"
}


### Wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "harsh@example.com",
    "password": "wrongpassword"
}


### ==========================================
###    FILE UPLOAD
### ==========================================

### Upload one image
# Field name is "photos" because multer uses upload.array('photos', 10)
POST {{baseUrl}}/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="photos"; filename="demo-upload.jpg"
Content-Type: image/jpeg

< ./public/images/1_1.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--


### ==========================================
###    PROPERTIES
### ==========================================

### Get all properties
GET {{baseUrl}}/properties

### Get a single property
GET {{baseUrl}}/properties/{{propertyId}}

### Invalid property ID
# Tests router.param('id', validateParams)
GET {{baseUrl}}/properties/abc

### Get property owner contact
# Login required
GET {{baseUrl}}/properties/{{propertyId}}/contact
Authorization: Bearer {{token}}


### Create property
# title is generated by the backend
POST {{baseUrl}}/properties
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "cityId": 8,
    "locality": "Dwarka",
    "rent": 25000,
    "deposit": 50000,
    "carpetAreaSqft": 900,
    "bedrooms": 2,
    "bathrooms": 2,
    "floorNo": 3,
    "furnishing": "semi_furnished",
    "propertyType": "apartment",
    "hasParking": true,
    "hasLift": true
}


### Create property with uploaded photos
# Replace the photo path with the path returned by POST /upload
POST {{baseUrl}}/properties
Authorization: Bearer {{token}}
Content-Type: application/json
{
    "cityId": 8,
    "locality": "Dwarka",
    "rent": 25000,
    "deposit": 50000,
    "carpetAreaSqft": 900,
    "bedrooms": 2,
    "bathrooms": 2,
    "floorNo": 3,
    "furnishing": "semi_furnished",
    "propertyType": "apartment",
    "hasParking": true,
    "hasLift": true,
    "photos": [
        "/images/user_1_1711000000.jpg"
    ]
}


### Create property - bad request
# No title should be sent from the client
POST {{baseUrl}}/properties
Authorization: Bearer {{token}}
Content-Type: application/json
{
    "title": "Beautiful 2 BHK in Indiranagar",
    "rent": 45000
}


### Update property
# Must be owned by the logged-in user
PATCH {{baseUrl}}/properties/{{propertyId}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
    "locality": "Rohini",
    "bedrooms": 3,
    "hasLift": false
}


### Update only rent
PATCH {{baseUrl}}/properties/{{propertyId}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
    "rent": 22000
}


### Delete property
# Running this will actually delete the property
DELETE {{baseUrl}}/properties/{{propertyId}}
Authorization: Bearer {{token}}


### ==========================================
###    PROPERTIES with filters : Query String
### ==========================================

### Get all properties (No filters, should return newest first)
GET {{baseUrl}}/properties


### SINGLE Array Item (Tests if Joi .single() correctly wraps one item into an array)
GET {{baseUrl}}/properties?bedrooms=2


### MULTIPLE Array Items (Tests if SQL = ANY() correctly finds either 1 OR 2 BHK)
GET {{baseUrl}}/properties?bedrooms=1&bedrooms=2


### MULTIPLE String Array Items (Tests furnishing filters)
GET {{baseUrl}}/properties?furnishing=semi_furnished&furnishing=fully_furnished


### TENANT PREFERENCES - Single (Only single men)
GET {{baseUrl}}/properties?allowSingleMale=true


### TENANT PREFERENCES - Multiple (Tests the custom OR logic grouping)
# Should return properties that allow Single Men OR Families
GET {{baseUrl}}/properties?allowSingleMale=true&allowFamily=true


### EXACT BOOLEANS (Tests if explicit 'false' works because of our !== undefined check)
# Should only return properties that DO NOT have a lift
GET {{baseUrl}}/properties?hasLift=false


### RANGES & EXACT MATCHES (Tests rent limits and city combination)
GET {{baseUrl}}/properties?cityId=1&minRent=10000&maxRent=25000&hasParking=true


### THE "MEGATRON" QUERY (Tests absolute robustness)
# Combines Arrays, Exact Matches, Booleans, Tenant OR logic, and Sorting
GET {{baseUrl}}/properties?cityId=1&bedrooms=1&bedrooms=2&allowSingleMale=true&allowFamily=true&furnishing=semi_furnished&furnishing=fully_furnished&hasParking=true&sort=rent_asc

### Another
GET {{baseUrl}}/properties?cityId=1&locality=Rohini&bedrooms=2&maxRent=20000&sort=rent_asc


### ==========================================
###    ME
### ==========================================

### Get current logged-in user
GET {{baseUrl}}/me
Authorization: Bearer {{token}}


### Get my properties
GET {{baseUrl}}/me/properties
Authorization: Bearer {{token}}


### ==========================================
###    FAVORITES
### ==========================================

### Get my favorites
GET {{baseUrl}}/me/favorites
Authorization: Bearer {{token}}


### Toggle favorite ON
# Add property to favorites
POST {{baseUrl}}/me/favorites/{{propertyId}}
Authorization: Bearer {{token}}


### Toggle favorite OFF
# Send the same request again to remove it
POST {{baseUrl}}/me/favorites/{{propertyId}}
Authorization: Bearer {{token}}


