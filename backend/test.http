# Change this when testing another property
@propertyId = 1


### ==========================================
### 1. AUTHENTICATION
### ==========================================

### Signup
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
    "name": "Harsh Test",
    "email": "harsh@example.com",
    "password": "password123",
    "phone": "9876543210"
}


### Login
# Copy the returned token into @token above
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "harsh@example.com",
    "password": "password123"
}


### Wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "harsh@example.com",
    "password": "wrongpassword"
}


### ==========================================
### 2. FILE UPLOAD
### ==========================================

### Upload one image
# Field name is "photos" because multer uses upload.array('photos', 10)
POST {{baseUrl}}/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="photos"; filename="demo-upload.jpg"
Content-Type: image/jpeg

< ./public/images/1_1.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--


### ==========================================
### 3. PROPERTIES
### ==========================================

### Get all properties
GET {{baseUrl}}/properties


### Get properties with filters
GET {{baseUrl}}/properties?cityId=1&locality=saket&bedrooms=2&maxRent=20000&sort=rent_asc


### Get a single property
GET {{baseUrl}}/properties/{{propertyId}}


### Invalid property ID
# Tests router.param('id', validateParams)
GET {{baseUrl}}/properties/abc


### Get property owner contact
# Login required
GET {{baseUrl}}/properties/{{propertyId}}/contact
Authorization: Bearer {{token}}


### Create property
# title is generated by the backend
POST {{baseUrl}}/properties
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "cityId": 8,
    "locality": "Dwarka",
    "rent": 25000,
    "deposit": 50000,
    "carpetAreaSqft": 900,
    "bedrooms": 2,
    "bathrooms": 2,
    "floorNo": 3,
    "furnishing": "semi_furnished",
    "propertyType": "apartment",
    "hasParking": true,
    "hasLift": true
}


### Create property with uploaded photos
# Replace the photo path with the path returned by POST /upload
POST {{baseUrl}}/properties
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "cityId": 8,
    "locality": "Dwarka",
    "rent": 25000,
    "deposit": 50000,
    "carpetAreaSqft": 900,
    "bedrooms": 2,
    "bathrooms": 2,
    "floorNo": 3,
    "furnishing": "semi_furnished",
    "propertyType": "apartment",
    "hasParking": true,
    "hasLift": true,
    "photos": [
        "/images/user_1_1711000000.jpg"
    ]
}


### Create property - bad request
# No title should be sent from the client
POST {{baseUrl}}/properties
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "Beautiful 2 BHK in Indiranagar",
    "rent": 45000
}


### Update property
# Must be owned by the logged-in user
PATCH {{baseUrl}}/properties/{{propertyId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "locality": "Rohini",
    "bedrooms": 3,
    "hasLift": false
}


### Update only rent
PATCH {{baseUrl}}/properties/{{propertyId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "rent": 22000
}


### Delete property
# Running this will actually delete the property
DELETE {{baseUrl}}/properties/{{propertyId}}
Authorization: Bearer {{token}}


### ==========================================
### 4. ME
### ==========================================

### Get current logged-in user
GET {{baseUrl}}/me
Authorization: Bearer {{token}}


### Get my properties
GET {{baseUrl}}/me/properties
Authorization: Bearer {{token}}


### ==========================================
### 5. FAVORITES
### ==========================================

### Get my favorites
GET {{baseUrl}}/me/favorites
Authorization: Bearer {{token}}


### Toggle favorite ON
# Add property to favorites
POST {{baseUrl}}/me/favorites/{{propertyId}}
Authorization: Bearer {{token}}


### Toggle favorite OFF
# Send the same request again to remove it
POST {{baseUrl}}/me/favorites/{{propertyId}}
Authorization: Bearer {{token}}


### ==========================================
### 6. STATIC ASSETS
### ==========================================

### Test image serving
# Replace filename with an actual file in public/images
GET {{host}}/images/user_1_1711000000.jpg


### ==========================================
### 7. CONFIG DATA
### ==========================================

### Get config data
GET {{baseUrl}}/config