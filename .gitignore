# ==============================================================================
# Environment Variables, Secrets & Credentials (CRITICAL)
# ==============================================================================
# Environment files across root, backend, and frontend
.env
.env.*
!.env.example

# Android signing keys, keystores, and certificate files
*.keystore
*.jks
signing.properties

# Google Services / Firebase credentials (if added later)
google-services.json


# ==============================================================================
# Monorepo Sub-projects: Node.js (Express Backend & React/Vite Frontend)
# ==============================================================================
# Node dependency folders (covers root, backend/, and frontend/)
**/node_modules/
.eslintcache

# Production web build artifacts
**/dist/
**/dist-ssr/
*.local


# ==============================================================================
# Monorepo Sub-projects: Android Native Client (rentals/android)
# ==============================================================================
# Gradle build cache and system directories
**/.gradle/
**/build/

# Local machine SDK paths and private IP configuration (DO NOT COMMIT)
**/local.properties
default.size.properties

# Android C/C++ build artifacts & profiler captures
**/.cxx/
**/captures/

# Android Testing, Lint, and Report outputs
lint/intermediates/
lint/generated/
lint/outputs/

# Packaged Android application files
*.apk
*.aab

# Ensure Gradle wrapper JAR is ALWAYS tracked by Git
!**/gradle/wrapper/gradle-wrapper.jar


# ==============================================================================
# Editors, IDEs & Workspaces (VSCodium, VS Code, Android Studio)
# ==============================================================================
# VS Code / VSCodium workspace configurations and history
**/.vscode/
**/.vscode-oss/
*.code-workspace
.history/

# IntelliJ / Android Studio project files (matches root and android/.idea/)
**/.idea/
**/*.iml
**/*.iws
out/

# Sublime Text workspaces
*.sublime-project
*.sublime-workspace
sftp-config.json

# Visual Studio temporary files
*.sln
*.suo
*.ntvs*
*.njsproj


# ==============================================================================
# Operating System & Diagnostic Logs
# ==============================================================================
# Linux / macOS / Windows system files
.DS_Store
Thumbs.db
*.swp
*.sw?
*~

# Log files across all environments
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*